<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Tree View -->
    <record id="view_department_tree"
            model="ir.ui.view">

        <field name="name">
            student.department.tree
        </field>

        <field name="model">
            student.department
        </field>

        <field name="arch" type="xml">

            <tree>
                <field name="name"/>
                <field name="hod_name"/>
            </tree>

        </field>

    </record>

    <!-- Form View -->
    <record id="view_department_form"
            model="ir.ui.view">

        <field name="name">
            student.department.form
        </field>

        <field name="model">
            student.department
        </field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>

                        <field name="hod_name"/>

                    </group>

                    <notebook>

                        <page string="Students">

                            <field name="student_ids">

                                <tree>
                                    <field name="student_id"/>
                                    <field name="name"/>
                                    <field name="course_id"/>
                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>

    <!-- Action -->
    <record id="department_action"
            model="ir.actions.act_window">

        <field name="name">Departments</field>

        <field name="res_model">
            student.department
        </field>

        <field name="view_mode">
            tree,form
        </field>

    </record>

</odoo>