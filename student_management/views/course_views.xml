<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- =========================
         TREE VIEW
    ========================== -->

    <record id="view_course_tree"
            model="ir.ui.view">

        <field name="name">
            student.course.tree
        </field>

        <field name="model">
            student.course
        </field>

        <field name="arch" type="xml">

            <tree string="Courses">

                <field name="name"/>

                <field name="code"/>

                <field name="duration"/>

                <field name="fee"/>

            </tree>

        </field>

    </record>


    <!-- =========================
         FORM VIEW
    ========================== -->

    <record id="view_course_form"
            model="ir.ui.view">

        <field name="name">
            student.course.form
        </field>

        <field name="model">
            student.course
        </field>

        <field name="arch" type="xml">

            <form string="Course">

                <sheet>

                    <group>

                        <group>

                            <field name="name"/>

                            <field name="code"/>

                        </group>

                        <group>

                            <field name="duration"/>

                            <field name="fee"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Description">

                            <field name="description"/>

                        </page>

                        <page string="Students">

                            <field name="student_ids">

                                <tree>

                                    <field name="student_id"/>

                                    <field name="name"/>

                                    <field name="email"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- =========================
         SEARCH VIEW
    ========================== -->

    <record id="view_course_search"
            model="ir.ui.view">

        <field name="name">
            student.course.search
        </field>

        <field name="model">
            student.course
        </field>

        <field name="arch" type="xml">

            <search string="Search Courses">

                <field name="name"/>

                <field name="code"/>

                <filter string="Long Duration"
                        name="long_duration"
                        domain="[('duration','>',12)]"/>

            </search>

        </field>

    </record>


    <!-- =========================
         ACTION
    ========================== -->

    <record id="course_action"
            model="ir.actions.act_window">

        <field name="name">
            Courses
        </field>

        <field name="res_model">
            student.course
        </field>

        <field name="view_mode">
            tree,form
        </field>

        <field name="search_view_id"
               ref="view_course_search"/>

    </record>

</odoo>